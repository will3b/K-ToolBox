# ── K-ToolBox — Environment Variables ──
# Copy this file:  cp .env.example .env
# Then fill in the values you need.

# ── Site URL (required for sitemap, checkout redirects, etc.) ──
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ── Database ──
# Docker:  file:/app/data/toolbox.db  (default in docker-compose.yml)
# Local:   file:./db/dev.db
DATABASE_URL=file:/app/data/toolbox.db

# ── Admin Settings Password ──
# Used to unlock /settings page where you configure the AI provider.
# CHANGE THIS in production!
SETTINGS_PASSWORD=changeme

# ── Pro Cookie Secret ──
# Signs the pro-activation cookie. Must be a long random string.
PRO_COOKIE_SECRET=change-this-to-a-random-string-min-32-chars

# ── PostHog Analytics (optional — leave empty to disable) ──
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── Stripe (optional — for paid pro checkout) ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── LemonSqueezy (optional — alternative payment provider) ──
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_PRODUCT_ID=

# ── App Port (for docker-compose only) ──
APP_PORT=3000
